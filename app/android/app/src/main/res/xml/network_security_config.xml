<?xml version="1.0" encoding="utf-8"?>
<!--
  Phase 9 (§17): certificate pinning for Google Drive. Only the Drive API
  hosts are pinned; everything else keeps the system defaults. Pins are
  the SPKI SHA-256 digests of the four Google Trust Services roots,
  computed from the certificates at https://pki.goog (GTS Root R1–R4).
  Remote attestation failures surface as SyncTransportFailure, not as
  silent bypasses.
-->
<network-security-config>
    <domain-config cleartextTrafficPermitted="false">
        <domain includeSubdomains="true">googleapis.com</domain>
        <pin-set expiration="2036-06-22">
            <!-- GTS Root R1 (RSA 4096) -->
            <pin digest="SHA-256">hxqRlPTu1bMS/0DITB1SSu0vd4u/8l8TjPgfaAp63Gc=</pin>
            <!-- GTS Root R2 (RSA 4096) -->
            <pin digest="SHA-256">Vfd95BwDeSQo+NUYxVEEIlvkOlWY2SalKK1lPhzOx78=</pin>
            <!-- GTS Root R3 (ECDSA P-384) -->
            <pin digest="SHA-256">QXnt2YHvdHR3tJYmQIr0Paosp6t/nggsEGD4QJZ3Q0g=</pin>
            <!-- GTS Root R4 (ECDSA P-384) -->
            <pin digest="SHA-256">mEflZT5enoR1FuXLgYYGqnVEoZvmf9c2bVBpiOjYQ0c=</pin>
        </pin-set>
    </domain-config>
</network-security-config>
